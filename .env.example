# Copy this file to .env and fill in only what you need. aiswe reads .env
# automatically on every `aiswe run` (see src/aiswe/cli.py). .env itself is
# gitignored -- never commit real keys.
#
# ============================================================================
# PROVIDERS -- add ANY of these, aiswe auto-detects what's usable
# ============================================================================
# This is generic, not tied to one provider: add whichever key(s) you have,
# and model_router.py picks up on it automatically -- no code changes. Add
# more than one so the automatic fallback chain has somewhere to go if one
# provider is down or rate-limited. Free models are always preferred over
# paid ones unless you explicitly name a paid model (AISWE_MODEL below) --
# see model_router.py's MODEL_CATALOG/build_model_chain for the exact rule,
# and PROVIDER_KEY_ENV there for the full list of recognized providers
# (OpenRouter, Groq, Gemini, Cerebras, Anthropic, OpenAI, Mistral, Together,
# Fireworks, DeepInfra, xAI, Cohere -- adding a provider not yet in that dict
# is one line in model_router.py).
#
#   OpenRouter (free-tier models, ":free" suffix): https://openrouter.ai/settings/keys
#   This one key covers ~20 different free models across many labs (Nvidia,
#   Qwen, Google, etc.) -- see model_router.py, which already uses several.
OPENROUTER_API_KEY=

#   Groq (generous free tier, very fast inference): https://console.groq.com/keys
GROQ_API_KEY=

#   Optional extra FREE providers -- not in model_router.py's MODEL_CATALOG
#   defaults (their current free-tier model ids weren't verified live), but
#   adding a key here plus the model in AISWE_STRONG_MODELS/AISWE_FAST_MODELS
#   below works immediately, no code changes needed:
#   Google Gemini (separate free tier from OpenRouter's Google models,
#   different infra -- real diversification): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#   Cerebras (free tier, very fast Llama inference): https://cloud.cerebras.ai/
# CEREBRAS_API_KEY=

#   Optional PAID providers -- only ever used as a last-resort fallback (or
#   immediately if you set AISWE_MODEL to one of their models yourself), with
#   a printed [billing] warning either way. Already recognized, no code
#   changes needed if you add a key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MISTRAL_API_KEY=

# ============================================================================
# MODEL SELECTION (all optional -- auto-routing needs none of this)
# ============================================================================

# Force one specific litellm model id for every run, skipping automatic
# task-based routing and fallback entirely (format: "<provider>/<model>",
# e.g. "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
# "groq/llama-3.1-8b-instant", or "anthropic/claude-sonnet-5" if you added
# ANTHROPIC_API_KEY above -- any provider in model_router.PROVIDER_KEY_ENV works):
# AISWE_MODEL=

# Override the "hard task" and "simple task" model pools (comma-separated
# litellm model ids, tried in order with automatic fallback), replacing
# model_router.MODEL_CATALOG's auto-detected list entirely. Verify current
# free-tier model ids yourself -- they change over time:
#   https://openrouter.ai/api/v1/models (JSON; filter id ending ":free")
#   https://console.groq.com/docs/models
#   https://ai.google.dev/gemini-api/docs/pricing (free tier models)
#   https://inference-docs.cerebras.ai/ (models list)
# AISWE_STRONG_MODELS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/qwen/qwen3.8-27b:free,gemini/gemini-2.0-flash
# AISWE_FAST_MODELS=groq/llama-3.1-8b-instant,openrouter/liquid/lfm-2.5-2.6b:free,cerebras/llama-3.3-70b

# ============================================================================
# SANDBOX (optional)
# ============================================================================

# Container runtime for the per-task sandbox. Defaults to "runc" (standard
# Docker). Set to "runsc" once gVisor is installed (see PLAN.md Phase 0/2) for
# stronger, syscall-level isolation -- no code changes needed, just this flag.
# AISWE_DOCKER_RUNTIME=runc
